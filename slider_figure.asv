function slider_figure(data, sf, ef, np, stepSize, numMeasurements)   
    HALF_CM = 671;
    INITIAL_FREQUENCY = 9.0006;
    INITIAL_BATCHES = [1 2];
  
    fig_h = 800;
    fig_w = 1200;
    
    % 1. Create a UI figure window
    fig = uifigure('Name', 'Intensity along the Slit', 'Position', [100, 100, fig_w, fig_h]);
    
    % 2. Create a tab group inside the figure
    tgroup = uitabgroup(fig, 'Units', 'normalized', 'Position', [0 0 1 1]);

    % 3. Create individual tabs within the tab group
    tab1 = uitab(tgroup, 'Title', 'Graph');
    tab2 = uitab(tgroup, 'Title', 'Batch Control');

    % Create a 1x1 grid layout that fills the entire figure
    g = uigridlayout(tab1, [2, 2]);
    g.RowHeight = {'10x', '1x'};
    g.ColumnWidth = {'5x', '1x'};

    % Create axes inside the grid and center it
    ax = uiaxes(g);
    ax.Layout.Row = 1;
    ax.Layout.Column = [1, 2];
    
    % Infer tube length and array index from experiment parameters
    diff = (stepSize/HALF_CM) * 0.5; % Conversion stepSize ---> [cm]
    tubeLength = (numMeasurements - 1) * diff;

    freq_spacing = (ef - sf) / (np-1);
    index = 1 + round((INITIAL_FREQUENCY - sf)/freq_spacing);

    % Initial data setup
    x = linspace(0, tubeLength, numMeasurements);
    y = extractHeights(data, INITIAL_BATCHES, index);

    % Initial plot
    p = plot(ax, x, y, 'LineWidth', 2);
    ax.XLim = [0, tubeLength];
    title(ax, ['Frequency: ', num2str(INITIAL_FREQUENCY)]);

    % 3. Create a UI slider component
    txtField = uieditfield(g, 'text', ...
        'Position', [100, 200, 150, 30], ...
        'Value', num2str(INITIAL_FREQUENCY), ...
        'ValueChangedFcn', @(txtField, event) disp(txtField.Value));
    txtField.Layout.Row = 2;
    txtField.Layout.Column =2;

    sld = uislider(g, ...
        'Position', [100, 50, 450, 3], ...
        'Limits', [1, np], ...
        'Value', INITIAL_FREQUENCY, ...
        'ValueChangedFcn', @(sld, event) sliderUpdate(sld, txtField, p, ax, sf, ef, np, data));
    sld.Layout.Row = 2;
    sld.Layout.Column = 1;

    for num = 1:length(data)
        if any(INITIAL_BATCHES(:) == num)
            uicheckbox('Parent', tab2, ...          % Place it in tab1 (or fig)
            'Text', ['Batch', num2str(num)], ...   % The text next to the box
            'Value', 1, ...              % 0 = unchecked, 1 = checked
            'Position', [50 fig_h - (100 + 25*num) 100 20], ... % [left bottom width height] in pixels
            'ValueChangedFcn', @(cb, event) checkboxUpdate(tab2, cb, p)); % Assigns the handler
        else
            uicheckbox('Parent', tab2, ...          % Place it in tab1 (or fig)
            'Text', ['Batch', num2str(num)], ...   % The text next to the box
            'Value', 0, ...              % 0 = unchecked, 1 = checked
            'Position', [50 fig_h - (100 + 25*num) 100 20], ... % [left bottom width height] in pixels
            'ValueChangedFcn', @(cb, event) checkboxUpdate(tab2, cb, p)); % Assigns the handler
        end
    end
end


function sliderUpdate(sld, txtField, p, ax, sf, ef, np, data)
    index = sld.Value; % Get current slider value
    freq = sf + (index - 1) * (ef - sf) / (np - 1);
    y = extractHeights(data, [1 2], index);  % Update plot y-data
    for i = 1:width(y)
        p(i).YData = y(:, i); 
    end
    drawnow;
    title(ax, ['Frequency: ', num2str(freq)]); % Update title
    txtField.Value = num2str(freq);
end



function checkboxUpdate(tab2, cb, p)
    allCheckboxes = findobj(tab2, 'Type', 'uicheckbox');
    for box = allCheckboxes
        disp
    disp(allCheckboxes);
end